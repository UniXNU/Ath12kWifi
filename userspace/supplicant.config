# Native station profile: WPA2-PSK/open, PMF, upstream SME and WPA state machine.
CONFIG_DRIVER_SHENG=y
CONFIG_L2_PACKET=sheng
CONFIG_CTRL_IFACE=unix
CONFIG_ELOOP_POLL=y
CONFIG_OSX=y
CONFIG_BACKEND=file
CONFIG_NO_CONFIG_WRITE=y
CONFIG_NO_CONFIG_BLOBS=y
CONFIG_NO_TKIP=y
CONFIG_TLS=internal
CONFIG_CRYPTO=internal
CONFIG_INTERNAL_LIBTOMMATH=y
CONFIG_IEEE80211W=y
CONFIG_SHA256=y
CONFIG_NO_GITVER=y
